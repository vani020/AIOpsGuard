# Copy to .env (never commit .env)
DATABASE_URL=postgresql://postgres:ira@localhost:5432/aiopsguard
TEST_DATABASE_URL=postgresql://postgres:ira@localhost:5432/aiopsguard_test

# LLM root-cause analysis. Leave empty to use the built-in rule-based RCA fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# ML hard safety thresholds (percent)
CPU_HARD_THRESHOLD=90
MEM_HARD_THRESHOLD=85
